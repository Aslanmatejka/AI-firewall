<Window x:Class="AiShield.Consent.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Firewall"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        ShowInTaskbar="False" Topmost="True"
        Background="#E6040408" FontFamily="Segoe UI" FontSize="15">
    <Window.Resources>
        <Style x:Key="PromptButton" TargetType="Button">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#00F5FF"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#0F0F18" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="14" Padding="32,28">
        <StackPanel>
            <TextBlock Text="AI FIREWALL" Foreground="#00F5FF" FontSize="12" FontWeight="Bold"/>
            <TextBlock x:Name="TitleText" Margin="0,10,0,0" Foreground="White" FontSize="24" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="SummaryText" Margin="0,14,0,0" Foreground="White" FontSize="16" TextWrapping="Wrap"/>
            <ItemsControl x:Name="DetailsList" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#A8A8C0" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="RequestedByText" Margin="0,18,0,0" Foreground="#686880" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0" Foreground="#686880" FontSize="13" TextWrapping="Wrap"
                       Text="Only AI Firewall can show this screen. Apps on your PC can't see or click it."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                <Button x:Name="AllowButton" Style="{StaticResource PromptButton}" IsEnabled="False"
                        Background="#1E1E2E" BorderBrush="#2A2A40" Click="Allow_Click"/>
                <Button x:Name="DenyButton" Style="{StaticResource PromptButton}" Content="Don't allow"
                        Background="#7B2FFF" BorderBrush="#7B2FFF" IsDefault="True" IsCancel="True" Click="Deny_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
