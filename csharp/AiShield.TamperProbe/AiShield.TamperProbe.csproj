<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test tool for CI. It attacks an installed service the way an AI app running as the user could. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AiShield.TamperProbe</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiShield.Core\AiShield.Core.csproj" />
  </ItemGroup>
</Project>
