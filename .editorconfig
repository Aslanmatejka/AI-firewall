root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,csproj,props,sln,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{xaml,csproj,props}]
indent_size = 2

[*.py]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
